<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <servlet>
        <servlet-name>Configuration</servlet-name>
        <servlet-class>jdbc_application.servlets.ConfigurationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Configuration</servlet-name>
        <url-pattern>/configuration</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>User</servlet-name>
        <servlet-class>jdbc_application.servlets.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>User</servlet-name>
        <url-pattern>/user</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>workUserServlet</servlet-name>
        <servlet-class>jdbc_application.servlets.workUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>workUserServlet</servlet-name>
        <url-pattern>/workuser</url-pattern>
    </servlet-mapping>
</web-app>